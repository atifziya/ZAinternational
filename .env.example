# Firebase web app configuration. These values identify a public web client; they are not admin secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=asia-south1

# Optional App Check site key (e.g. reCAPTCHA v3 or reCAPTCHA Enterprise)
VITE_FIREBASE_APPCHECK_KEY=

# Optional public deployment URL used for canonical and sharing metadata.
VITE_SITE_URL=
