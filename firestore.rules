rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function packageIsValid() {
      return request.resource.data.keys().hasOnly([
        'slug', 'title', 'category', 'shortDescription', 'description',
        'featuredImage', 'gallery', 'duration', 'itinerary', 'inclusions',
        'exclusions', 'price', 'priceLabel', 'currency', 'availability',
        'status', 'departureDate', 'updatedAt', 'createdAt', 'createdBy',
        'updatedBy', 'localeContent', 'seoTitle', 'seoDescription', 'migrationSource'
      ])
      && request.resource.data.title is string
      && request.resource.data.title.size() > 1
      && request.resource.data.slug is string
      && request.resource.data.slug.matches('^[a-z0-9]+(?:-[a-z0-9]+)*$')
      && request.resource.data.category in ['umrah', 'hajj']
      && request.resource.data.status in ['draft', 'published', 'closed', 'archived']
      && request.resource.data.description is string
      && request.resource.data.shortDescription is string
      && request.resource.data.itinerary is list
      && request.resource.data.inclusions is list
      && request.resource.data.exclusions is list
      && request.resource.data.currency is string
      && request.resource.data.availability is string;
    }

    function jobIsValid() {
      return request.resource.data.keys().hasOnly([
        'slug', 'title', 'country', 'location', 'category', 'description',
        'requirements', 'salary', 'currency', 'benefits',
        'applicationInstructions', 'applicationDeadline', 'status',
        'localeContent', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ])
      && request.resource.data.title is string
      && request.resource.data.title.size() > 1
      && request.resource.data.slug is string
      && request.resource.data.slug.matches('^[a-z0-9]+(?:-[a-z0-9]+)*$')
      && request.resource.data.country is string
      && request.resource.data.category is string
      && request.resource.data.description is string
      && request.resource.data.requirements is list
      && request.resource.data.benefits is list
      && request.resource.data.applicationInstructions is string
      && request.resource.data.status in ['draft', 'published', 'closed', 'archived'];
    }

    function enquiryIsValid() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'name', 'phone', 'email', 'category', 'selectedItem', 'travelDate',
        'message', 'consent', 'status', 'createdAt', 'updatedAt'
      ])
      && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
      && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 30
      && (data.email == null || (data.email is string && data.email.size() <= 160))
      && data.category in ['general', 'hajj', 'umrah', 'jobs', 'travel', 'documentation']
      && (data.selectedItem == null || (data.selectedItem is string && data.selectedItem.size() <= 150))
      && (data.travelDate == null || (data.travelDate is string && data.travelDate.size() <= 30))
      && data.message is string && data.message.size() >= 10 && data.message.size() <= 1500
      && data.consent == true
      && data.status == 'new'
      && data.createdAt == request.time
      && data.updatedAt == request.time;
    }

    match /packages/{packageId} {
      allow get, list: if (resource.data.status == 'published') || admin();
      allow create, update: if admin() && packageIsValid();
      allow delete: if admin();
    }

    match /jobs/{jobId} {
      allow get, list: if (resource.data.status == 'published') || admin();
      allow create, update: if admin() && jobIsValid();
      allow delete: if admin();
    }

    match /siteSettings/public {
      allow read: if true;
      allow write: if admin();
    }

    match /faqs/{faqId} {
      allow get, list: if (resource.data.status == 'published') || admin();
      allow write: if admin();
    }

    // Direct public creation allowed ONLY under strict Spark-compatible schema validation.
    // Public reads, updates, and deletes remain strictly forbidden.
    match /enquiries/{enquiryId} {
      allow read, update, delete: if admin();
      allow create: if enquiryIsValid();
    }

    match /jobApplications/{applicationId} {
      allow read, write: if admin();
    }

    match /media/{mediaId} {
      allow read: if true;
      allow write: if admin();
    }

    match /adminActivity/{activityId} {
      allow read, create: if admin();
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
